# Server
HOST=0.0.0.0
PORT=3000

# Postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=home_app
PGSSL=false
# Optional CA certificate path for managed PostgreSQL providers such as Aiven.
# PGSSL_CA=./ca.pem

# JWT — use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Redis (docker compose up -d)
REDIS_URL=redis://127.0.0.1:6379
